<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_step"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/ScreenTitle"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/infoButton"
            style="@style/IconButton"
            android:contentDescription="@string/info"
            android:src="@drawable/ic_info" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tabToday"
            style="@style/TabButton"
            android:layout_marginEnd="6dp"
            android:text="@string/tab_today" />

        <Button
            android:id="@+id/tabHabits"
            style="@style/TabButton"
            android:layout_marginEnd="6dp"
            android:text="@string/tab_habits" />

        <Button
            android:id="@+id/tabStream"
            style="@style/TabButton"
            android:layout_marginEnd="6dp"
            android:text="@string/tab_stream" />

        <Button
            android:id="@+id/tabBackup"
            style="@style/TabButton"
            android:text="@string/tab_backup" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panelToday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:filterTouchesWhenObscured="true"
        android:orientation="vertical">

        <EditText
            android:id="@+id/quickInput"
            style="@style/TextField"
            android:importantForAutofill="no"
            android:hint="@string/quick_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="200" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/quickAdd"
                style="@style/TabButton"
                android:layout_marginEnd="6dp"
                android:text="@string/quick_add" />

            <Button
                android:id="@+id/addDetails"
                style="@style/TabButton"
                android:layout_weight="2"
                android:text="@string/add_details" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panelHabits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:filterTouchesWhenObscured="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/habitInput"
            style="@style/TextField"
            android:importantForAutofill="no"
            android:layout_width="0dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="3"
            android:hint="@string/habit_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="80" />

        <Button
            android:id="@+id/habitAdd"
            style="@style/TabButton"
            android:text="@string/habit_add" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panelStream"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:filterTouchesWhenObscured="true"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/slotAdd"
            style="@style/TabButton"
            android:layout_marginEnd="6dp"
            android:text="@string/slot_add" />

        <Button
            android:id="@+id/copySchedule"
            style="@style/TabButton"
            android:text="@string/copy_schedule" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panelBackup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:filterTouchesWhenObscured="true"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/exportButton"
            style="@style/TabButton"
            android:layout_marginEnd="6dp"
            android:text="@string/export_button" />

        <Button
            android:id="@+id/importButton"
            style="@style/TabButton"
            android:text="@string/import_button" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/bar"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/brand_soft"
        android:progressBackgroundTint="@color/surface_high"
        android:progressTint="@color/brand_soft"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:filterTouchesWhenObscured="true"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="16dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
